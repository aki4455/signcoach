# Copy to .env (never commit .env). systemd reads the deploy checkout's .env via EnvironmentFile.

# Shared data root: datasets, model weights, training runs.
SIGNCOACH_DATA=/home/akmal/signcoach-data
# prod in ~/signcoach-deploy, dev in the development checkout. Each has its own db/uploads/jobs/media.
SIGNCOACH_INSTANCE=dev
# cpu while the GPU is training, cuda:0 otherwise.
SIGNCOACH_DEVICE=cpu

# Ultralytics: never pip-install packages at runtime, never phone home.
YOLO_AUTOINSTALL=false
YOLO_OFFLINE=true
